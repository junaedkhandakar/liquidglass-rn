{
  "name": "liquidglass-rn",
  "version": "1.2.0",
  "description": "A modern open-source React Native UI library recreating Apple-style Liquid Glass effects for Expo and React Native applications.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "docs": "node serve.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "glassmorphism",
    "liquid-glass",
    "reanimated",
    "skia",
    "visionos",
    "apple-ui",
    "react-native-reanimated",
    "react-native-skia",
    "blur",
    "metaball",
    "ui-library"
  ],
  "author": "Junaed Khandakar",
  "license": "MIT",
  "homepage": "https://github.com/junaedkhandakar/liquidglass-rn#readme",
  "bugs": {
    "url": "https://github.com/junaedkhandakar/liquidglass-rn/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/junaedkhandakar/liquidglass-rn"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "lucide-react-native": "^1.16.0"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "*",
    "expo": "*",
    "expo-blur": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": false
}
