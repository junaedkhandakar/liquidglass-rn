{
  "name": "react-native-liquidglass",
  "version": "1.0.1",
  "description": "A modern open-source React Native UI library recreating Apple-style Liquid Glass effects for Expo and React Native applications.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "expo",
    "glassmorphism",
    "liquid-glass",
    "reanimated",
    "skia",
    "visionos",
    "apple-ui",
    "react-native-reanimated",
    "react-native-skia"
  ],
  "author": "LiquidRN Team",
  "license": "MIT",
  "homepage": "https://github.com/Junaed93/react-native-liquidglass#readme",
  "bugs": {
    "url": "https://github.com/Junaed93/react-native-liquidglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Junaed93/react-native-liquidglass.git"
  },
  "dependencies": {
    "lucide-react-native": "^1.16.0"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "*",
    "expo": "*",
    "expo-blur": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "~5.9.2"
  },
  "private": false
